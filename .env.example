CAMPEX_ENV=development
CAMPEX_SERVICE_NAME=campex
CAMPEX_VERSION=0.1.0
CAMPEX_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./storage/campex_dev.sqlite3
CAMPEX_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CAMERA_RECONNECT_SECONDS=5
CAMERA_STALE_SECONDS=10
CAMERA_READ_FAILURE_LIMIT=3
CAMERA_TEST_TIMEOUT_SECONDS=5
VISION_ENABLED=true
VISION_DETECTOR=rfdetr
VISION_DEVICE=auto
VISION_FPS=5
VISION_CONFIDENCE=0.50
VISION_VIDEO_LOOP=true
VISION_FULL_SCAN_SECONDS=6
VISION_TRACKER_LOST_BUFFER=30
INTELLIGENCE_ENABLED=true
CAMPEX_DEFAULT_ORGANIZATION_ID=default
CAMPEX_ALLOWED_ORGANIZATION_IDS=default
CAMPEX_ORGANIZATION_TOKENS=
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_TIMEOUT_SECONDS=20
NEMOTRON_TEMPERATURE=0.2
NEMOTRON_TOP_P=0.7
NEMOTRON_MAX_TOKENS=700
